rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function accountPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function accountExists(userId) {
      return exists(accountPath(userId));
    }

    function accountData(userId) {
      return get(accountPath(userId)).data;
    }

    function deletionActive(userId) {
      return accountExists(userId)
             && accountData(userId).keys().hasAny(['deletionInProgress'])
             && accountData(userId).deletionInProgress in ['health', 'account'];
    }

    function signupAccountKeysOnly() {
      return request.resource.data.keys().hasOnly(['name', 'email', 'createdAt']);
    }

    // After write, the account document may only contain identity fields.
    // Server-owned deletion guard fields are therefore impossible for clients.
    function accountDocIdentityShapeOnly() {
      return request.resource.data.keys().hasOnly(['name', 'email', 'createdAt']);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
                    && signupAccountKeysOnly();

      allow update: if isOwner(userId)
                    && !deletionActive(userId)
                    && accountDocIdentityShapeOnly();

      allow delete: if false;

      // Require at least one collection segment so this does NOT match the
      // account root document (recursive ** can match an empty remainder).
      match /{collectionId}/{document=**} {
        allow read: if isOwner(userId);

        allow write: if isOwner(userId)
                     && accountExists(userId)
                     && !deletionActive(userId);
      }
    }
  }
}
