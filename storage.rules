rules_version = '2';

// Medical reports are personal. Only the owner of users/{userId}/… may read or
// write those objects.
//
// Phase 9: source report files and reviewed extracted text are separate paths
// with separate MIME/size rules. Overlapping Firebase Storage allows are
// additive, so there is intentionally no broad catch-all write rule.
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // SOURCE report object — one path segment under the report id.
    // Does not match nested …/derived/extracted.txt.
    match /users/{userId}/reports/{reportId}/{sourceFileName} {
      allow read, delete: if isOwner(userId);

      allow create, update: if isOwner(userId)
                            && request.resource.size < 20 * 1024 * 1024
                            && request.resource.contentType.matches(
                                 'image/.*|application/pdf');
    }

    // DERIVED reviewed text — exact path only, text/plain, 256 KiB cap.
    match /users/{userId}/reports/{reportId}/derived/extracted.txt {
      allow read, delete: if isOwner(userId);

      allow create, update: if isOwner(userId)
                            && request.resource.size <= 256 * 1024
                            && request.resource.contentType == 'text/plain';
    }
  }
}
